<?xml version="1.0" encoding="utf-8"?>
<!--
  The counter at a glance, without unlocking anything.

  Four numbers and two buttons, and nothing else. A widget competes with the
  agent's wallpaper for space, so it earns its place by answering the one
  question asked before opening the shutter — is there enough float — and by
  making the commonest action, adding an entry, one tap instead of four.

  Every text view has a Bangla-safe height: Bangla glyphs have taller ascenders
  than Latin ones and a tight line height clips the matra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_shop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_ink_dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_title"/>

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/widget_ink_dim"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_float_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_ink_dim"/>
            <TextView
                android:id="@+id/widget_float"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_cash_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_ink_dim"/>
            <TextView
                android:id="@+id/widget_cash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_ink_dim"/>

    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:textColor="@color/widget_warn"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/widget_inbox"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"/>
    </LinearLayout>
</LinearLayout>
