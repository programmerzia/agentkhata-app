<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional: SMS capture. The app works without it via notification access. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
      Asked for once, during setup. On Tecno, Infinix, Xiaomi, Oppo, Realme and
      Vivo — the phones agents carry — an app that is not exempt from battery
      optimisation has its notification listener stopped within hours, and
      capture then fails without a sound until someone opens the app.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:label="এজেন্ট খাতা"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              Where pairing comes back to.

              The CoreBari web app finishes the sign-in, mints a device token
              and redirects to agentkhata://paired#code=... The fragment
              carries a single-use code rather than the token itself, because a
              custom scheme is not exclusive on Android: another installed app
              can claim it too. See DeviceSession.pair.
            -->
        </activity>
        <!--
          The redirect must land on flutter_web_auth_2's own activity: it is
          what completes the pending authenticate() call. Declared on
          MainActivity instead, the browser came back to the app and the
          pairing future never saw the code, so every connect "failed".
        -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="agentkhata" android:host="paired"/>
            </intent-filter>
        </activity>
        <service
            android:name=".OperatorNotificationListener"
            android:exported="true"
            android:label="এজেন্ট খাতা"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>
        <!--
          The launcher widget. Exported because the launcher, another process,
          is what sends it ACTION_APPWIDGET_UPDATE.
        -->
        <receiver android:name=".HomeScreenWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agentkhata_widget_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <!--
          The operator apps, so setup can see which ones this phone has and
          pre-tick "this phone captures bKash and Nagad". Keep in step with
          OperatorNotificationListener.PACKAGES.
        -->
        <package android:name="com.bkash.businessapp"/>
        <package android:name="com.bkash.customerapp"/>
        <package android:name="com.konasl.nagad.agent"/>
        <package android:name="com.konasl.nagad"/>
        <package android:name="com.dbbl.mbs.apps.main"/>
        <package android:name="com.ucb.upay"/>
        <package android:name="com.trustbank.tap"/>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
